{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeywordRecommendationResult",
  "description": "일일보고 원문에서 기존 프로젝트 키워드와 신규 프로젝트 후보를 추출한 결과.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "keywordAdditions": {
      "type": "array",
      "description": "이미 등록된 프로젝트에 붙일 키워드. 등록 목록에 없는 프로젝트는 넣지 않는다.",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectName": {
            "type": "string",
            "description": "등록된 프로젝트 명. 목록에 있는 이름만 사용한다.",
            "minLength": 1,
            "maxLength": 100
          },
          "suggestedKeywords": {
            "type": "array",
            "description": "해당 프로젝트를 가리키는 약칭·오탈자·화면명·기능명. 다른 시스템 이름은 넣지 않는다.",
            "uniqueItems": true,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "reason": {
            "type": "string",
            "description": "원문 근거를 한두 문장으로 적는다.",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": ["projectName", "suggestedKeywords", "reason"]
      }
    },
    "newProjects": {
      "type": "array",
      "description": "등록 목록에 없는 프로젝트·제품·시스템·과제 후보.",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectName": {
            "type": "string",
            "description": "원문에 나온 새 프로젝트 명. 업무명·사람명·부서명은 쓰지 않는다.",
            "minLength": 1,
            "maxLength": 100
          },
          "suggestedKeywords": {
            "type": "array",
            "description": "새 프로젝트를 찾기 위한 약칭·화면명·기능명. 없으면 빈 배열.",
            "uniqueItems": true,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "reason": {
            "type": "string",
            "description": "원문 근거를 한두 문장으로 적는다.",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": ["projectName", "suggestedKeywords", "reason"]
      }
    }
  },
  "required": ["keywordAdditions", "newProjects"]
}
