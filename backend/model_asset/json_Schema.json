{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DailyReportExtractionResult",
  "description": "일일보고 1건 추출 결과. 명세서 4.2) 자동 구조화 기준. 요약 없음, dateRange 없음.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "completedTasks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "inProgressTasks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "issues": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "content": { "type": "string", "minLength": 1, "maxLength": 300 },
                "status": { "type": "string", "enum": ["해결", "미해결"] }
              },
              "required": ["content", "status"]
            }
          },
          "requests": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "nextPlans": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "required": ["projectName", "completedTasks", "inProgressTasks", "issues", "requests", "nextPlans"]
      }
    }
  },
  "required": ["projects"]
}
